<deployment-project plugin="plugin.apptool" plugin-version="1.0">
  <configuration file="{{PRJ_FILE}}" location="{{STAGE}}" name="SimWorkbench" target="target.mlapps" target-name="打包为 App">
    <param.appname>SimWorkbench</param.appname>
    <param.authnamewatermark />
    <param.email />
    <param.company />
    <param.icon>${PROJECT_ROOT}\resources\icons\icon_24.png</param.icon>
    <param.icons>
      <file>${PROJECT_ROOT}\resources\icons\icon_48.png</file>
      <file>${PROJECT_ROOT}\resources\icons\icon_24.png</file>
      <file>${PROJECT_ROOT}\resources\icons\icon_16.png</file>
    </param.icons>
    <param.summary>All-in-One Simulink 建模工作台</param.summary>
    <param.description>Excel 数据字典 → .sldd，端口工作簿 → 模型与端口；统一 GUI + 无界面服务层。</param.description>
    <param.screenshot />
    <param.version>{{VERSION}}</param.version>
    <param.products.name />
    <param.products.id />
    <param.products.version />
    <param.platforms />
    <param.output>${PROJECT_ROOT}</param.output>
    <param.guid>{{GUID}}</param.guid>
    <unset>
      <param.authnamewatermark />
      <param.email />
      <param.company />
      <param.screenshot />
      <param.products.name />
      <param.products.id />
      <param.products.version />
      <param.platforms />
      <param.output />
    </unset>
    <fileset.main>
{{MAIN_FILES}}
    </fileset.main>
    <fileset.depfun>
{{DEPFUN_FILES}}
    </fileset.depfun>
    <fileset.resources>
{{RESOURCE_FILES}}
    </fileset.resources>
    <fileset.package />
    <build-deliverables>
      <file location="{{STAGE}}" name="SimWorkbench" optional="false">{{STAGE}}</file>
    </build-deliverables>
    <workflow />
    <matlab>
      <root>E:\MATLAB\R2024b</root>
      <toolboxes />
    </matlab>
    <platform>
      <unix>false</unix>
      <mac>false</mac>
      <windows>true</windows>
      <win2k>false</win2k>
      <winxp>false</winxp>
      <vista>false</vista>
      <linux>false</linux>
      <solaris>false</solaris>
      <osver>10.0</osver>
      <os32>false</os32>
      <os64>true</os64>
      <arch>win64</arch>
      <matlab>true</matlab>
    </platform>
  </configuration>
</deployment-project>
